<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31) splash-screen overrides.
    Without these the system defaults to a white background, which makes
    the dark launcher icon look broken on first launch.
-->
<resources>
    <style name="Theme.QuestDevSettings" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_app_gradient</item>
        <item name="android:colorBackground">@color/bg_app_top</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:navigationBarColor">@color/bg_app_top</item>
        <item name="android:statusBarColor">@color/bg_app_top</item>
        <!-- Splash screen: dark background matching the app gradient top colour -->
        <item name="android:windowSplashScreenBackground">@color/bg_app_top</item>
        <!-- Splash screen: show the logo icon centred on that background -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/guide_step_intro_logo</item>
    </style>
</resources>
