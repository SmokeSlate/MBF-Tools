    <string name="guide_support_body">The live FAQ and fix form stay available during setup.</string>
    <string name="guide_screenshot_placeholder">Guide screenshot placeholder</string>
    <string name="guide_step_welcome_title">Before you start</string>
    <string name="guide_step_welcome_body">Check both requirements before continuing. This setup path requires Multiple Accounts to be off and the headset unlock code or PIN to be off.</string>
    <string name="guide_check_multiple_accounts">I confirmed there are not Multiple Accounts on this headset.</string>
    <string name="guide_check_unlock_code">I confirmed the headset unlock code or PIN is off.</string>
    <string name="guide_step_settings_title">Open Settings</string>
    <string name="guide_step_settings_body">Press the button below. When the popup window appears, click Open so the headset opens Android Settings.</string>
    <string name="guide_step_about_open_title">Open About</string>
    <string name="guide_step_about_open_body">In Android Settings, open About so Build Number is visible on the next screen.</string>
    <string name="guide_step_build_number_title">Click Build Number 7 times</string>
    <string name="guide_step_build_number_body">Tap Build Number 7 times to enable Android developer mode. You cannot continue until Android developer mode is enabled.</string>
    <string name="guide_step_wireless_menu_title">Open the Wireless Debugging menu</string>
    <string name="guide_step_wireless_menu_body">This step opens Developer Settings for you. If needed, use the Open Developer Settings button below. Then click Wireless Debugging to open its menu.</string>
    <string name="guide_step_wireless_title">Turn on Wireless Debugging</string>
    <string name="guide_step_wireless_body">Turn on Wireless Debugging inside its menu. You cannot continue until Wireless Debugging is enabled.</string>
    <string name="guide_step_pair_title">Pair with pairing code</string>
    <string name="guide_step_pair_body">Choose Pair with pairing code on the headset, enter the 6-digit code here, then press Pair Device. The app will detect the pairing port if needed, then use the detected wireless debug port to connect automatically.</string>
    <string name="guide_pair_summary_default">Enter the 6-digit pairing code, then press Enter or Pair Device. Extra port fields are under Change Details.</string>
    <string name="guide_pair_summary_ready">Pairing port: %1$s. Debug port: %2$s. Use Change Details to edit.</string>
    <string name="guide_step_launch_title">Launch MBF inside this app</string>
    <string name="guide_step_launch_body">Once connected, press Launch MBF In This App. That starts the upstream MBF bridge locally and loads the live MBF web UI in the built-in browser.</string>
    <string name="guide_caption_welcome">Beat Saber Modding setup guide.</string>
    <string name="guide_caption_enable_dev_mode">When Settings App Info opens, click Open.</string>
    <string name="guide_caption_about_open">Open About headset from Android Settings.</string>
    <string name="guide_caption_build_number">Tap Build number seven times on the About headset screen.</string>
    <string name="guide_caption_dev_settings">Open Wireless debugging from Developer options.</string>
    <string name="guide_caption_wireless_debugging">Turn on Wireless debugging, then choose Pair device with pairing code.</string>
    <string name="guide_caption_pair_code">Enter the six-digit code shown on the headset. The app can detect the pairing port if needed.</string>
    <string name="guide_caption_connect_port">Wireless Debugging page with the active wireless debug port.</string>
    <string name="guide_caption_launch_mbf">Final MBF screen inside the built-in browser.</string>
